[
  {
    "adapter": "JavaScript",
    "label": "Launch Chrome (Angular)",
    "type": "chrome",
    "request": "launch",
    "url": "http://localhost:4200",
    "webRoot": "$ZED_WORKTREE_ROOT",
    "sourceMaps": true,
    "skipFiles": ["<node_internals>/**"]
  },
  {
    "adapter": "JavaScript",
    "label": "Attach Chrome (Angular)",
    "type": "chrome",
    "request": "attach",
    "url": "http://localhost:4200",
    "port": 9222,
    "webRoot": "$ZED_WORKTREE_ROOT"
  }
]
