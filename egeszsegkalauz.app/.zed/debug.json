[
  {
    "label": "Debug API",
    "adapter": "netcoredbg",
    "request": "launch",
    "build": {
      "command": "dotnet",
      "args": ["build", "egeszsegkalauz.api/egeszsegkalauz.api.csproj", "-c", "Debug"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/egeszsegkalauz.api/bin/Debug/net10.0/egeszsegkalauz.api.dll",
    "cwd": "$ZED_WORKTREE_ROOT/egeszsegkalauz.api",
    "env": {
      "ASPNETCORE_ENVIRONMENT": "Development",
      "ASPNETCORE_URLS": "http://localhost:5130"
    },
    "stopOnEntry": false
  }
]
